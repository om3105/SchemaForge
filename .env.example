# GEMINI_API_KEY: Gemini API key used when the user doesn't supply their own.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port the server listens on (most hosts set this automatically). Defaults to 3000.
# PORT=3000

# GEMINI_MODEL: Optional Gemini model override. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash
